rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'thanhhaihvkt@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Lấy email từ user đang đăng nhập
    function currentUserEmail() {
      return isSignedIn() ? request.auth.token.email : '';
    }

    // Lấy email chuẩn hóa (lowercase, trim)
    function normalizeEmail(email) {
      return email is string ? email.lower().trim() : '';
    }

    // Kiểm tra teacherId trong document có phải của user đang đăng nhập hay không
    // bằng cách so sánh email của teacher (lookup từ collection teachers)
    function isOwnerTeacher(teacherId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/teachers/$(teacherId)
      ) && get(
        /databases/$(database)/documents/teachers/$(teacherId)
      ).data.email == currentUserEmail();
    }

    // Cho create: check teacherId trong request.resource.data
    function isOwnerTeacherOnCreate(teacherId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/teachers/$(teacherId)
      ) && get(
        /databases/$(database)/documents/teachers/$(teacherId)
      ).data.email == currentUserEmail();
    }

    // Cho update/delete: check teacherId trong resource.data
    function isOwnerTeacherOnResource(teacherId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/teachers/$(teacherId)
      ) && get(
        /databases/$(database)/documents/teachers/$(teacherId)
      ).data.email == currentUserEmail();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Entity shapes
    function isValidTeacher(data) {
      return data.id is string && data.id.size() <= 128
          && data.code is string && data.code.size() <= 50
          && data.name is string && data.name.size() <= 200
          && data.email is string && data.email.size() <= 150
          && data.department is string && data.department.size() <= 150
          && data.rank is string && (data.rank == 'GS' || data.rank == 'PGS' || data.rank == 'TS' || data.rank == 'ThS' || data.rank == 'CN' || data.rank == 'KS')
          && data.position is string && data.position.size() <= 200
          && data.status is string && (data.status == 'A' || data.status == 'I')
          && data.reductionRate is number;
    }

    function isValidTeachingLog(data) {
      return data.id is string && data.id.size() <= 128
          && data.teacherId is string && data.teacherId.size() <= 128
          && data.subjectCode is string && data.subjectCode.size() <= 50
          && data.subjectName is string && data.subjectName.size() <= 150
          && data.className is string && data.className.size() <= 50
          && data.credits is number
          && data.studentCount is number
          && data.coefficient is number
          && data.actualHours is number
          && data.convertedHours is number
          && data.semester is string && data.semester.size() <= 10
          && data.academicYear is string && data.academicYear.size() <= 20
          // tkbSheets (Số tờ TKB/KH) là field tùy chọn, nếu có phải là number
          && (!('tkbSheets' in data) || data.tkbSheets is number);
    }

    function isValidWorkHistory(data) {
      return data.id is string && data.id.size() <= 128
          && data.teacherId is string && data.teacherId.size() <= 128
          && data.academicYear is string && data.academicYear.size() <= 20
          && data.department is string && data.department.size() <= 150
          && data.position is string && data.position.size() <= 200
          && data.academicTitle is string && data.academicTitle.size() <= 100
          && data.rank is string && (data.rank == 'GS' || data.rank == 'PGS' || data.rank == 'TS' || data.rank == 'ThS' || data.rank == 'CN' || data.rank == 'KS')
          && data.reductionRate is number
          && data.status is string && (data.status == 'A' || data.status == 'I')
          && data.party is string && data.party.size() <= 100;
    }

    function isValidResearchLog(data) {
      return data.id is string && data.id.size() <= 128
          && data.teacherId is string && data.teacherId.size() <= 128
          && data.title is string && data.title.size() <= 250
          && data.type is string && data.type.size() <= 50
          && data.role is string && data.role.size() <= 50
          && data.points is number
          && data.convertedHours is number
          && data.publicationYear is string && data.publicationYear.size() <= 10
          && data.period is string && data.period.size() <= 50
          && data.journalOrOrganization is string && data.journalOrOrganization.size() <= 200
          && data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected');
    }

    // 1. Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Teachers Collection
    match /teachers/{teacherId} {
      allow read, list: if isSignedIn();
      allow create: if (isAdmin() || isOwnerTeacherOnCreate(teacherId)) && isValidTeacher(request.resource.data) && isValidId(teacherId);
      allow update: if (isAdmin() || isOwnerTeacherOnResource(teacherId)) && isValidTeacher(request.resource.data) && isValidId(teacherId);
      allow delete: if isAdmin();
    }

    // 3. Teaching Logs Collection
    match /teaching_logs/{logId} {
      allow read, list: if isSignedIn();
      allow create: if (isAdmin() || isOwnerTeacherOnCreate(request.resource.data.teacherId)) && isValidTeachingLog(request.resource.data) && isValidId(logId);
      allow update: if (isAdmin() || isOwnerTeacherOnResource(resource.data.teacherId)) && isValidTeachingLog(request.resource.data) && isValidId(logId);
      allow delete: if isAdmin() || isOwnerTeacherOnResource(resource.data.teacherId);
    }

    // 4. Research Logs Collection
    match /research_logs/{logId} {
      allow read, list: if isSignedIn();
      allow create: if (isAdmin() || isOwnerTeacherOnCreate(request.resource.data.teacherId)) && isValidResearchLog(request.resource.data) && isValidId(logId);
      allow update: if (isAdmin() || isOwnerTeacherOnResource(resource.data.teacherId)) && isValidResearchLog(request.resource.data) && isValidId(logId);
      allow delete: if isAdmin() || isOwnerTeacherOnResource(resource.data.teacherId);
    }

    // 5. Rank Norms Collection
    match /rank_norms/{rankId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() && isValidId(rankId);
    }

    // 6. Academic Years Collection
    match /academic_years/{yearId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() && isValidId(yearId);
    }

    // 7. Audit Logs Collection
    match /audit_logs/{logId} {
      allow read, list: if isAdmin();
      allow create: if isAdmin();
      allow write: if isAdmin();
    }

    // 8. User Roles Collection
    match /user_roles/{userId} {
      allow read, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 8. Work History Collection
    match /work_histories/{whId} {
      allow read, list: if isSignedIn();
      // Giảng viên có thể tạo/sửa work_history của chính họ (dựa trên email)
      allow create: if (isAdmin() || isOwnerTeacherOnCreate(request.resource.data.teacherId)) && isValidWorkHistory(request.resource.data) && isValidId(whId);
      allow update: if (isAdmin() || isOwnerTeacherOnResource(resource.data.teacherId)) && isValidWorkHistory(request.resource.data) && isValidId(whId);
      allow delete: if isAdmin() || isOwnerTeacherOnResource(resource.data.teacherId);
    }
  }
}
